# Copy this file to .env and fill in your own keys. Never commit .env!

# Free token: https://aqicn.org/data-platform/token/
WAQI_API_TOKEN=

# Meteomatics Weather API account: https://www.meteomatics.com/en/weather-api/
# Without it the weather page still works using clearly labelled simulated data.
METEOMATICS_USERNAME=
METEOMATICS_PASSWORD=

# Optional server settings
SKYSENTRY_HOST=127.0.0.1
SKYSENTRY_PORT=5000
SKYSENTRY_DEBUG=0
